cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
*.log
*.sqlite3
*.db

# Django
*.log
*.pot
*.pyc
local_settings.py
db.sqlite3
media/
static/
staticfiles/

# Environment Variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.coverage
htmlcov/
.tox/
.pytest_cache/
.mypy_cache/

# Node modules (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Frontend
build/
dist/
*.min.js
*.min.css

# Docker
*.pid
docker-compose.override.yml

# Temporary files
tmp/
temp/
*.tmp
EOF